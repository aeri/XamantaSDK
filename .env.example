# Copy to .env and adjust. Read by Docker Compose for ${...} interpolation.

# DNS hostname the devices connect to; becomes a DNS SAN on the cert. Clients using a
# hostname send it as TLS SNI.
SERVER_NAME=localhost

# IP address the devices connect to; becomes an IP SAN on the cert. Required for TLS
# validation when a client connects by IP (IP clients send no SNI; see default_sni).
SERVER_IP=127.0.0.1

# Host port Caddy publishes (HTTPS only; Caddy serves on 8443 inside the container).
HTTPS_PORT=8443
