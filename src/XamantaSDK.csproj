<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>76a1524c-72a7-4483-a33e-1c989f739218</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- Feeds the XML doc comments on the controllers into the generated OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: only the documented surface (controllers and their models) needs doc comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Writing spec/XamantaSDK.json means starting the app, so it is off by default. Refresh it
         with: dotnet build -p:OpenApiGenerateDocuments=true -->
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\spec</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\policy.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\commands.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.83.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned above the 10.0.0 transitive 2.0.0, which is affected by CVE-2026-49451.
         Stays on 2.x: Microsoft.AspNetCore.OpenApi 10.0.12 requires < 3.0.0, and its XML
         comment source generator does not compile against the 3.x read-only interfaces. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

</Project>
