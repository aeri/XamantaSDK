# Copy to app.env (required):  cp app.env.example app.env
# Injected into the app container (ASP.NET Core config keys use __ for nesting).
# Uncomment and set a key for PRODUCTION; left commented, nothing is injected and the app
# falls back to appsettings.json, whose signing key is DEV-ONLY.

# Symmetric key that signs the device access tokens (HS256). Use a long random value.
#OAuth__JwtSigningKey=

# Extra secret mixed into client-secret hashing. Optional but recommended.
#OAuth__SecretPepper=

# Operator API key for the REST admin surface (/devices, /policies, /enrollments), sent by the
# caller in the X-Admin-Api-Key header. Fail closed: while this is unset those endpoints reject
# EVERY request with 401. Use a long random value, e.g. openssl rand -base64 32.
#Admin__ApiKey=
